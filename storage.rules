rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /snaps/{senderUid}/{snapId} {
      // Only the sender can upload their own snaps.
      allow write: if request.auth != null && request.auth.uid == senderUid;
      // Any signed-in user can read (needed to display received snaps).
      allow read: if request.auth != null;
    }
  }
}
